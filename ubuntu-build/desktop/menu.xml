<?xml version="1.0" encoding="UTF-8"?>
<!-- Bootbox desktop v14 start menu (the panel's Apps button or a right-click on the desktop).
     The everyday apps sit at the top; everything else is grouped in submenus (tap to open). -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="internet-menu" label="Internet">
    <item label="Web browser (fast: the iPad's own engine)" icon="/usr/share/bootbox/icons/browser.png"><action name="Execute"><command>bbweb</command></action></item>
    <item label="Web browser (Linux WebKitGTK, emulated)" icon="/usr/share/bootbox/icons/browser.png"><action name="Execute"><command>bbweb --linux</command></action></item>
    <item label="Lite browser (Dillo, no JavaScript)" icon="/usr/share/bootbox/icons/browser.png"><action name="Execute"><command>dillo https://lite.duckduckgo.com/lite/</command></action></item>
  </menu>
  <menu id="accessories-menu" label="Accessories">
    <item label="Text editor" icon="/usr/share/bootbox/icons/editor.png"><action name="Execute"><command>mousepad</command></action></item>
    <item label="Calculator" icon="/usr/share/bootbox/icons/calc.png"><action name="Execute"><command>galculator</command></action></item>
    <item label="Image viewer" icon="/usr/share/bootbox/icons/viewer.png"><action name="Execute"><command>gpicview</command></action></item>
    <item label="Archive manager" icon="/usr/share/bootbox/icons/archive.png"><action name="Execute"><command>xarchiver</command></action></item>
    <item label="Files" icon="/usr/share/bootbox/icons/files.png"><action name="Execute"><command>pcmanfm</command></action></item>
  </menu>
  <menu id="dev-menu" label="Development">
    <item label="Python" icon="/usr/share/bootbox/icons/python.png"><action name="Execute"><command>bxterm -T Python -e python3</command></action></item>
    <item label="Midnight Commander" icon="/usr/share/bootbox/icons/mc.png"><action name="Execute"><command>bxterm -T "Midnight Commander" -geometry 100x30 -e mc</command></action></item>
    <item label="Terminal" icon="/usr/share/bootbox/icons/terminal.png"><action name="Execute"><command>bxterm</command></action></item>
  </menu>
  <menu id="system-menu" label="System">
    <item label="System monitor (htop)" icon="/usr/share/bootbox/icons/monitor.png"><action name="Execute"><command>bxterm -T "System monitor" -geometry 100x30 -e htop</command></action></item>
    <item label="System info" icon="/usr/share/bootbox/icons/sysinfo.png"><action name="Execute"><command>bxterm -T "System info" -geometry 90x26 -e sh -c "fastfetch; echo; printf 'Press Enter to close'; read x"</command></action></item>
    <item label="Help" icon="/usr/share/bootbox/icons/help.png"><action name="Execute"><command>bxterm -T Help -geometry 90x34 -e sh -c "bootbox-help; echo; printf 'Press Enter to close'; read x"</command></action></item>
  </menu>
  <menu id="bench-menu" label="Benchmarks">
    <item label="Benchmarks hub (all, with results)" icon="/usr/share/bootbox/icons/bench.png"><action name="Execute"><command>bbweb bootbox://app/hub</command></action></item>
    <separator/>
    <item label="CPU-Z benchmark" icon="/usr/share/bootbox/icons/cpuz.png"><action name="Execute"><command>bxterm -T "CPU-Z benchmark" -geometry 80x22 -e sh -c "cpuz-bench; echo; printf 'Press Enter to close'; read x"</command></action></item>
    <item label="CPU-Z (window)" icon="/usr/share/bootbox/icons/cpuz.png"><action name="Execute"><command>cpuz-gui</command></action></item>
    <item label="7-Zip benchmark" icon="/usr/share/bootbox/icons/zip.png"><action name="Execute"><command>bxterm -T "7-Zip benchmark" -geometry 88x26 -e sh -c "7z-bench; echo; printf 'Press Enter to close'; read x"</command></action></item>
    <item label="sysbench CPU (quick)" icon="/usr/share/bootbox/icons/bench.png"><action name="Execute"><command>bxterm -T "sysbench CPU" -geometry 80x22 -e sh -c "sysbench-bench; echo; printf 'Press Enter to close'; read x"</command></action></item>
    <item label="GPU benchmark (glmark2)" icon="/usr/share/bootbox/icons/gpu.png"><action name="Execute"><command>bxterm -T "GPU benchmark" -geometry 90x24 -e sh -c "gpu-bench; echo; printf 'Press Enter to close'; read x"</command></action></item>
    <item label="Web benchmark (browser)" icon="/usr/share/bootbox/icons/browser.png"><action name="Execute"><command>bbweb bootbox://app/webbench</command></action></item>
  </menu>
  <menu id="root-menu" label="Bootbox">
    <separator label="Bootbox Linux"/>
    <item label="Terminal" icon="/usr/share/bootbox/icons/terminal.png"><action name="Execute"><command>bxterm</command></action></item>
    <item label="Web browser" icon="/usr/share/bootbox/icons/browser.png"><action name="Execute"><command>bbweb</command></action></item>
    <item label="Files" icon="/usr/share/bootbox/icons/files.png"><action name="Execute"><command>pcmanfm</command></action></item>
    <item label="Text editor" icon="/usr/share/bootbox/icons/editor.png"><action name="Execute"><command>mousepad</command></action></item>
    <item label="Benchmarks" icon="/usr/share/bootbox/icons/bench.png"><action name="Execute"><command>bbweb bootbox://app/hub</command></action></item>
    <separator/>
    <menu id="internet-menu"/>
    <menu id="accessories-menu"/>
    <menu id="dev-menu"/>
    <menu id="system-menu"/>
    <menu id="bench-menu"/>
    <separator/>
    <item label="Show desktop"><action name="ToggleShowDesktop"/></item>
    <item label="Restart desktop"><action name="Restart"/></item>
  </menu>
</openbox_menu>
