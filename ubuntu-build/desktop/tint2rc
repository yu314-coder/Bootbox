# Bootbox desktop v12 panel: [Apps] start button · pinned launchers · window list · clock.
# Solid colours only (alpha is blended by tint2 itself, no compositor needed).

# --- backgrounds -----------------------------------------------------------------------------------
# 1 panel
rounded = 0
border_width = 1
border_sides = T
background_color = #0e1520 100
border_color = #263142 100
background_color_hover = #0e1520 100
border_color_hover = #263142 100
background_color_pressed = #0e1520 100
border_color_pressed = #263142 100

# 2 window button (normal)
