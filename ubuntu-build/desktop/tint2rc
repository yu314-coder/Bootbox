border_width = 0
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 9
border_color_hover = #ffffff 0
background_color_pressed = #ffffff 16
border_color_pressed = #ffffff 0

# 3 window button (active)
rounded = 6
border_width = 1
border_sides = B
background_color = #3d8bfd 22
border_color = #3d8bfd 100
background_color_hover = #3d8bfd 32
border_color_hover = #3d8bfd 100
background_color_pressed = #3d8bfd 42
border_color_pressed = #3d8bfd 100

# 4 start button
rounded = 7
border_width = 0
background_color = #3d8bfd 100
border_color = #3d8bfd 100
background_color_hover = #5b9dff 100
border_color_hover = #5b9dff 100
background_color_pressed = #2c6fd6 100
border_color_pressed = #2c6fd6 100

# 5 launcher icon
rounded = 7
border_width = 0
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 10
border_color_hover = #ffffff 0
background_color_pressed = #ffffff 18
