#!/bin/sh
# bench-all - every CPU/GPU benchmark of the hub, one after another (the hub's "Run all"); each saves
# its result to the Benchmarks hub as usual. One run = one screenshot of the hub's history.
echo "Running all benchmarks, one at a time (~15 min). Leave Bootbox in the foreground."
echo
for b in sysbench-bench 7z-bench cpuz-bench gpu-bench; do
  echo "################ $b"
  "$b" 2>&1 | tail -6
  echo
done
echo "All done - the Benchmarks hub lists every result."
