# Bootbox — flat dark openbox theme (desktop v8). Solid fills only: no gradients/alpha to keep the
# emulated X server's drawing cheap.
border.width: 1
padding.width: 10
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.label.text.justify: center

window.active.border.color: #3d8bfd
window.inactive.border.color: #263142
window.active.title.separator.color: #1b2433
window.inactive.title.separator.color: #131a26

window.active.title.bg: flat solid
window.active.title.bg.color: #1b2433
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #131a26
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #e8eef7
window.inactive.label.text.color: #7d8aa0

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #c8d3e3
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #2c3a50
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #3d8bfd
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #4a5568
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #c8d3e3
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #2c3a50
window.active.button.toggled.hover.image.color: #ffffff
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #3d8bfd
window.active.button.toggled.pressed.image.color: #ffffff

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #5d6a80
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #222c3d
window.inactive.button.hover.image.color: #c8d3e3
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3d8bfd
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #3a4454
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #5d6a80
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #222c3d
window.inactive.button.toggled.hover.image.color: #c8d3e3
window.inactive.button.toggled.pressed.bg: flat solid
window.inactive.button.toggled.pressed.bg.color: #3d8bfd
window.inactive.button.toggled.pressed.image.color: #ffffff

window.active.handle.bg: flat solid
window.active.handle.bg.color: #1b2433
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #131a26
window.active.grip.bg: flat solid
window.active.grip.bg.color: #1b2433
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #131a26

menu.border.width: 1
menu.border.color: #2b3646
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.separator.color: #2b3646
menu.title.bg: flat solid
menu.title.bg.color: #111827
menu.title.text.color: #8fbdec
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #161e2b
menu.items.text.color: #dfe8f5
menu.items.disabled.text.color: #5b6678
menu.items.active.bg: flat solid
menu.items.active.bg.color: #3d8bfd
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #9fb3d1

osd.border.width: 1
osd.border.color: #2b3646
osd.bg: flat solid
osd.bg.color: #161e2b
osd.label.bg: parentrelative
osd.label.text.color: #dfe8f5
osd.hilight.bg: flat solid
osd.hilight.bg.color: #3d8bfd
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #2b3646
