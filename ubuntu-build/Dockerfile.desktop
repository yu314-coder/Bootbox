# Bootbox DESKTOP guest (x86_64) — a lightweight graphical desktop. v10: bbweb (a small WebKitGTK
# browser with full JavaScript, built below) + Dillo as the no-JS lite browser, PCManFM, a bash terminal
# with the common tools, CPU-Z/glmark2 benchmarks (v9). Claude Code is no longer bundled (v10).
# v13: a faster browser - one shared web process (no ~10 s process start per tab / cross-site link),
# mimalloc instead of WebKit's madvise-happy allocator, and an ad/tracker blocker (filter pre-compiled here).
# v14: inside the Bootbox app, Web opens pages in the app's native browser (the iPad's own WebKit) via a
# console request (bbweb-launch.c open_native); `web --linux` / the Linux browser stay for bootbox:// pages.
# v15: hub "Run all" (bench-all), glmark2 from the hub works (benchmarks get a clean env), and the boot
# terminal waits for a real width before bash draws its prompt (the iPad showed it one letter per line).
# v16: closing the Linux browser quits it (it only hid, leaving ~220 MB of processes behind); the first page
# of the pre-started browser draws (it stayed blank grey until a reload) and no strip stays unpainted; the
# hub stops re-rendering every 4 s (~1/4 core while open); gpu-bench warms the shader cache untimed first.
# v17: benchmarks hold the browser's background pre-start (bb-hold.sh: it waits while one runs, and one
# under way is paused) - on the iPad it landed in CPU-Z's multi-thread phase; terminals start bash only
# once their window is mapped (xterm waitForMap) - the first prompt still came out one letter per line;
# font caches stay valid in the guest (they were rebuilt by every GUI program on every boot: ~15 s of
# emulated CPU each for openbox and the panel while the desktop started).
# v20: direct present - GL windows on the bridge are drawn by the app's viewer straight from the GPU (no frame
# read-back, no X image, no VNC encode); gpu-bench runs on the desktop when the bridge is there.
# v19: Bootbox GPU bridge (engine/bbgpu): GL apps draw on the iPad's GPU through WebGL2 when the app adds the
# bbgpu device; the container runs privileged in the VM (c2w spec) so the driver can map the device.
# v18 (Mac harness profiling of the desktop's common actions): the text editor keeps 27 common syntax
# languages instead of 137 - Mousepad loads every definition to build its Filetype menu (start-up CPU
# -32%, ~6 s sooner); the system widget refreshes every 5 s and drops its busiest-process line (its
# /proc scan was 40% of the widget's cost; idle CPU ~4% of a core -> ~1.5%).
# v2 (build 73): graphical browser (Dillo) + file manager (PCManFM) + a real wallpaper. HISTORY: dillo/BadWolf "flooded the single-threaded Xvnc until the GUI froze" — but that
# was tested BEFORE the cx16 engine fix, when every guest allocation took a stop-the-world exclusive
# section (kernel SLUB uses lock cmpxchg16b). With the spinlock engine those light GUI apps get
# RE-TESTED in the Mac harness before shipping. `links` (text, terminal) stays as fallback.
# Plus openbox/tint2 (v8) + terminal + mc. Python + pip preloaded.

# -- side stage (desktop v8): wallpaper + the desktop's PNG icons. Rendered here at native speed so the
#    guest never needs imagemagick/librsvg or the 200 MB Papirus theme (only ~10 PNGs are copied).
#    The wallpaper is ordered-dithered to RGB565: the desktop runs at depth 16, where the smooth dark
#    gradient otherwise posterizes into visible rings. --
FROM alpine:3.20 AS wall
COPY arch.svg /arch.svg
RUN apk add --no-cache imagemagick ttf-dejavu rsvg-convert papirus-icon-theme 2>&1 | tail -1 && \
    rsvg-convert -w 190 -h 156 /arch.svg -o /arch.png && \
    magick -size 1024x768 gradient:'#101826'-'#070b12' \
      \( -size 1024x768 radial-gradient:'#1a2740'-'#00000000' -alpha on \) -compose over -composite /bg.png && \
    magick /bg.png /arch.png -gravity center -geometry +0-52 -compose over -composite \
      -gravity center -fill '#8fbdec' -font /usr/share/fonts/dejavu/DejaVuSans-Bold.ttf -pointsize 32 -annotate +0+52 'BOOTBOX' \
      -gravity center -fill '#41608c' -font /usr/share/fonts/dejavu/DejaVuSans.ttf -pointsize 13 -annotate +0+86 'tap  Apps  in the bottom bar to start a program' \
      -ordered-dither o8x8,32,64,32 /wallpaper.png && \
    mkdir -p /icons && P=/usr/share/icons/Papirus/48x48/apps && \
    for m in terminal:utilities-terminal files:system-file-manager browser:web-browser python:python \
             mc:mc help:help-browser editor:accessories-text-editor cpuz:cpu-x gpu:GPU_Viewer \
             monitor:utilities-system-monitor calc:galculator viewer:gpicview archive:xarchiver zip:7zip \
             bench:hardinfo sysinfo:hardinfo; do \
      rsvg-convert -w 48 -h 48 "$P/${m#*:}.svg" -o "/icons/${m%%:*}.png"; done && \
    rsvg-convert -w 22 -h 18 /arch.svg -o /icons/start-raw.png && \
    magick -size 22x22 xc:none /icons/start-raw.png -gravity center -composite -channel RGB -fill white -colorize 100 /icons/start.png && \
    rm /icons/start-raw.png && \
    magick /icons/terminal.png -background '#1b2433' -flatten /icons/terminal.xpm && \
    ls -la /wallpaper.png /icons

# -- side stage (desktop v10): the browser (bbweb, WebKitGTK 4.1) and the XTEST key helper (bbkey),
#    compiled against the same Alpine release as the image so the runtime libraries match. --
FROM alpine:3.20 AS tools
RUN apk add --no-cache build-base pkgconf webkit2gtk-4.1-dev gtk+3.0-dev libx11-dev libxtst-dev 2>&1 | tail -1
COPY desktop/bbweb.c desktop/bbweb-launch.c desktop/bbkey.c /src/
RUN set -eux; cd /src; \
    gcc -O2 -Wall -Wextra -o bbweb-engine bbweb.c $(pkg-config --cflags --libs webkit2gtk-4.1 gtk+-3.0 gio-unix-2.0); \
    gcc -O2 -Wall -Wextra -o bbweb bbweb-launch.c -lX11; \
    gcc -O2 -Wall -o bbkey bbkey.c -lX11 -lXtst; \
    strip bbweb-engine bbweb bbkey; ls -la bbweb-engine bbweb bbkey

FROM alpine:3.20

# 1) Python 3 + FAST pip (uv) + stdlib bytecode (so python startup is fast under the TCG CPU).
RUN set -eux; \
    apk add --no-cache python3 py3-pip curl tar; \
    (apk add --no-cache uv 2>/dev/null || { \
       curl -fsSL https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-musl.tar.gz -o /tmp/uv.tgz; \
       tar xzf /tmp/uv.tgz -C /tmp; cp /tmp/uv-*/uv /tmp/uv-*/uvx /usr/local/bin/; rm -rf /tmp/uv*; }); \
    rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED; \
    python3 -m compileall -j 0 -q /usr/lib/python3.12 || true; \
    (/usr/local/bin/uv --version || uv --version)
ENV UV_SYSTEM_PYTHON=1
COPY pip-uv.sh /usr/local/bin/pip
RUN chmod +x /usr/local/bin/pip && ln -sf pip /usr/local/bin/pip3 && echo "PIP-UV-OK"

# 2) PIP OPTIMIZATION: pre-install a bigger curated set of common PURE-PYTHON packages so the user's
#    `pip install X` is INSTANT for them (no resolve/download). Compile their bytecode too. (C-extension
#    packages like numpy aren't pre-installed: PyPI ships glibc manylinux wheels, not musl, so they'd
#    build from source on Alpine — slow; `apk add py3-numpy` is the fast path if ever needed.)
RUN set -eux; \
    KEEP="requests flask rich click pyyaml httpx beautifulsoup4 pydantic urllib3 certifi idna charset-normalizer jinja2 markupsafe itsdangerous werkzeug python-dateutil six setuptools wheel packaging typing-extensions"; \
    uv pip install $KEEP 2>&1 | tail -2 || true; \
    uv cache clean 2>&1 | tail -1 || true; \
    python3 -m compileall -j 0 -q /usr/lib/python3.12/site-packages || true; \
    echo "PIP-PRELOAD [$(echo $KEEP | wc -w) pkgs] cache=$(du -sh /root/.cache/uv 2>/dev/null | cut -f1)"

# 3) Desktop: Xorg on the emulator's virtio GPU (v21 direct display: the app reads the screen straight
#    from the engine; bb-xorg) with Xvnc (X+VNC in one) as the fallback + openbox (v8; twm kept as the fallback WM) + tint2 (panel) + xterm
#    + browsers + mc. xdotool lets the panel's Apps button open openbox's menu.
RUN set -eux; \
    apk add --no-cache tigervnc twm tint2 xsetroot xterm font-misc-misc ttf-dejavu mc links openbox xdotool; \
    echo "DESKTOP-LAYER $(apk info 2>/dev/null | wc -l) pkgs twm=$(command -v twm)"
# 3a) v10 terminal: bash (completion, history search) + the tools `help` lists. busybox keeps providing
#     the rest; each of these is small. Completion is loaded on the first Tab (~/.bashrc): Alpine's
#     /etc/bash/bash_completion.sh hook sourced it in every new terminal - ~0.7 s each on the emulated CPU.
RUN set -eux; \
    apk add --no-cache bash bash-completion less htop ncdu nano vim tmux file jq bc zip unzip xz rsync \
      openssh-client sqlite fastfetch tree git-bash-completion 7zip sysbench 2>&1 | tail -1; \
    rm -f /etc/bash/bash_completion.sh; \
    for c in bash htop ncdu nano vim tmux jq fastfetch sqlite3 ssh rsync tree 7zz sysbench; do command -v $c >/dev/null; done; \
    echo "TERMINAL-TOOLS-OK"

# 3b) browsers + file manager + wallpaper tools. bbweb = WebKitGTK 4.1 (built in the tools stage;
#     glib-networking gives it TLS) · dillo = FLTK lite browser (CSS, no JS) · pcmanfm = light GTK
#     file manager · ripgrep + git for the terminal. (v10: Node.js + Claude Code removed.)
#     v13: mimalloc2-insecure = the browser's malloc (bbweb-launch.c engine_env: Malloc=1 + LD_PRELOAD).
RUN set -eux; \
    apk add --no-cache webkit2gtk-4.1 glib-networking dillo pcmanfm xwallpaper ripgrep git \
      conky mousepad galculator gpicview xarchiver mimalloc2-insecure 2>&1 | tail -1; \
    for c in conky mousepad galculator gpicview xarchiver; do command -v $c >/dev/null; done; \
    test -f /usr/lib/libmimalloc-insecure.so.2; \
    echo "DESKTOP-APPS-OK dillo=$(command -v dillo) pcmanfm=$(command -v pcmanfm)"
COPY --from=wall /wallpaper.png /usr/share/bootbox-wallpaper.png

# 3b2) icon theme: adwaita-icon-theme gives GTK apps (PCManFM, bbweb's toolbar) real icons.
#      libfm: single-click opens.
RUN set -eux; \
    apk add --no-cache adwaita-icon-theme 2>&1 | tail -1; \
    mkdir -p /root/.config/libfm; \
    printf '[config]\nsingle_click=1\nquick_exec=1\n' > /root/.config/libfm/libfm.conf; \
    echo "ICONTHEME-OK"
# 3b3) locale + `help`: alias in BOTH /etc/profile (login shells) AND $ENV=/etc/ashrc (every
#      interactive ash). Terminals use the `fixed` bitmap font (desktop/bxterm) - Xft TrueType in a
#      terminal is too slow on the emulated CPU.
RUN set -eux; \
    printf 'alias help=/usr/local/bin/bootbox-help\n' > /etc/ashrc; \
    printf 'export LANG=C.UTF-8\nexport LC_ALL=C.UTF-8\nexport ENV=/etc/ashrc\nalias help=/usr/local/bin/bootbox-help\n' > /etc/profile.d/00bootbox.sh; \
    echo "LOCALE-HELP-OK"
COPY bootbox-help.sh /usr/local/bin/bootbox-help
RUN chmod +x /usr/local/bin/bootbox-help && \
    printf 'alias help="/usr/local/bin/bootbox-help"\n' > /etc/profile.d/00bootbox-help.sh && \
    echo "HELP-OK"

# 3b4) v8 desktop (build 92): openbox + flat dark theme + tint2 panel with an Apps button, pinned
#      apps, window list and clock; Papirus PNG icons from the art stage; GTK apps (PCManFM) dark.
COPY --from=wall /icons/ /usr/share/bootbox/icons/
COPY desktop/apps/ /usr/share/bootbox-apps/
COPY desktop/openbox-theme/ /usr/share/themes/Bootbox/openbox-3/
COPY desktop/rc.xml desktop/menu.xml /root/.config/openbox/
COPY desktop/tint2rc /root/.config/tint2/tint2rc
COPY desktop/bxterm desktop/bootbox-menu desktop/bb-xorg /usr/local/bin/
COPY desktop/xorg-bootbox.conf /etc/X11/xorg-bootbox.conf
COPY --from=tools /src/bbweb /src/bbkey /usr/local/bin/
COPY --from=tools /src/bbweb-engine /usr/libexec/bbweb-engine
COPY desktop/start.html desktop/hub.html desktop/webbench.html /usr/share/bootbox/
COPY desktop/bootbox-conky desktop/bench/bbresult desktop/bench/7z-bench desktop/bench/sysbench-bench /usr/local/bin/
COPY desktop/bashrc /root/.bashrc
COPY desktop/bash_profile /root/.bash_profile
COPY desktop/bench/bb-hold.sh /usr/local/lib/bb-hold.sh
# v17 bb-hold.sh: a benchmark pauses a browser pre-start under way (matched by process NAME), a nested
# benchmark shares the outer pause, and everything continues when the outer one exits. The stand-in
# "browser" is a script named WebKitWebProcess (its comm), the same 15-char name WebKit's process gets.
RUN set -eux; \
    printf '#!/bin/sh\nwhile :; do sleep 1; done\n' > /tmp/WebKitWebProcess; chmod +x /tmp/WebKitWebProcess; \
    /tmp/WebKitWebProcess & p=$!; sleep 1; grep -q '^Name:.*WebKitWebProces' /proc/$p/status; \
    : > /tmp/.bbweb-prewarming; \
    sh -c ". /usr/local/lib/bb-hold.sh; grep -q '^State:.*T' /proc/$p/status; \
           sh -c '. /usr/local/lib/bb-hold.sh; true'; grep -q '^State:.*T' /proc/$p/status; echo HOLD-NESTED-OK"; \
    ! grep -q '^State:.*T' /proc/$p/status; \
    rm -f /tmp/.bbweb-prewarming; sh -c ". /usr/local/lib/bb-hold.sh; ! grep -q '^State:.*T' /proc/$p/status"; \
    kill $p; rm -f /tmp/WebKitWebProcess; test -z "$(ls -A /tmp/.bb-bench)"; rmdir /tmp/.bb-bench; echo "BB-HOLD-OK"
RUN set -eux; \
    chmod +x /usr/local/bin/bxterm /usr/local/bin/bootbox-menu /usr/share/bootbox-apps/*.desktop \
      /usr/local/bin/bootbox-conky /usr/local/bin/bbresult /usr/local/bin/7z-bench /usr/local/bin/sysbench-bench; \
    sed -i 's#^root:x:0:0:root:/root:/bin/sh$#root:x:0:0:root:/root:/bin/bash#' /etc/passwd; grep '^root:.*/bin/bash$' /etc/passwd; \
    printf 'export WEBKIT_DISABLE_COMPOSITING_MODE=1\nexport WEBKIT_DISABLE_DMABUF_RENDERER=1\nexport NO_AT_BRIDGE=1\n' > /etc/profile.d/10desktop.sh; \
    for b in /usr/libexec/bbweb-engine /usr/local/bin/bbweb /usr/local/bin/bbkey; do ldd $b | grep -iE "not found|Error relocating" && exit 1; done; \
    mkdir -p /root/.config/gtk-3.0; \
    printf '[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-theme-name=Adwaita\ngtk-icon-theme-name=Adwaita\ngtk-font-name=DejaVu Sans 10\ngtk-enable-animations=0\n' > /root/.config/gtk-3.0/settings.ini; \
    printf 'gtk-theme-name="Adwaita"\ngtk-font-name="DejaVu Sans 10"\n' > /root/.gtkrc-2.0; \
    printf 'RandomPlacement\nOpaqueMove\nNoGrabServer\nBorderWidth 2\nTitleFont "fixed"\nMenuFont "fixed"\nNoTitle { "tint2" }\nButton3 = : root : f.menu "apps"\nmenu "apps" {\n "Terminal" !"bxterm &"\n "Files" !"pcmanfm &"\n}\n' > /root/.twmrc; \
    openbox --version | head -1; ls /usr/share/bootbox/icons; echo "DESKTOP-V8-OK"

# 3d) v9 (build 95): benchmarks built in. CPU-Z (real Windows app) runs under Wine; glmark2 measures
#      the software GPU (Mesa llvmpipe). Same Wine recipe as the Linux Terminal image (Dockerfile.pw):
#      wine-staging + esync (the build that works under the wasm engine), a prefix baked and warmed
#      here at native speed (first-run wineboot takes minutes on the emulated CPU), debug channels off.
#      Mesa's gallium drivers + GLES (Alpine 3.20 stable: Mesa 24 + LLVM 17 - edge Mesa 26 drags in
#      newer libdrm/wayland and fails to load) + glmark2 (edge/testing) are installed here instead of
#      on first use (~65 MB that took minutes to fetch and unpack in the guest every boot).
RUN set -eux; \
    apk add --no-cache \
      -X https://dl-cdn.alpinelinux.org/alpine/edge/main \
      -X https://dl-cdn.alpinelinux.org/alpine/edge/community \
      -X https://dl-cdn.alpinelinux.org/alpine/edge/testing \
      wine-staging xwininfo 2>&1 | tail -3; \
    apk add --no-cache mesa-dri-gallium mesa-gles 2>&1 | tail -1; \
    apk add --no-cache -X https://dl-cdn.alpinelinux.org/alpine/edge/testing glmark2 2>&1 | tail -1; \
    for l in /usr/lib/libEGL.so.1 /usr/lib/libGLESv2.so.2 /usr/lib/libgbm.so.1 /usr/lib/xorg/modules/dri/swrast_dri.so; do \
      test -e "$l"; ! ldd "$l" 2>&1 | grep -iE "not found|Error relocating"; done; \
    wine --version; command -v glmark2-es2; \
    python3 -c "import requests; print('python-ok')"; \
    echo "WINE-MESA-OK $(wine --version) wine=$(du -sm /usr/lib/wine | cut -f1)MB"
# v19: Bootbox GPU bridge. The software DRI driver is Mesa 24.0.9 (the same release) built with the bbgpu
# driver and llvmpipe (engine/bbgpu/mesa/Dockerfile -> image bbgpu-mesa:24.0.9). bbgpu is Mesa's first
# choice and steps aside to llvmpipe without the device, without a writable /sys or when another program
# already owns the GPU - so everything that ran on llvmpipe still does.
COPY --from=bbgpu-mesa:24.0.9 /out/dri/libgallium_dri.so /usr/lib/xorg/modules/dri/libgallium_dri.so
RUN set -eux; \
    strings /usr/lib/xorg/modules/dri/libgallium_dri.so | grep -q "Bootbox GPU (WebGL2)"; \
    strings /usr/lib/xorg/modules/dri/libgallium_dri.so | grep -q "xcb_translate_coordinates"; \
    ! ldd /usr/lib/xorg/modules/dri/libgallium_dri.so 2>&1 | grep -iE "not found|Error relocating"; \
    echo "BBGPU-DRI-OK"
# v20: fill Mesa's shader cache for the bridge driver here, at native speed: BBGPU_NULL=1 runs the driver
# without a device (commands are dropped) so Mesa compiles every glmark2 shader exactly as on the iPad;
# GL apps then skip the GLSL compiler on the emulated CPU from their first run.
RUN set -eux; \
    apk add --no-cache xvfb 2>&1 | tail -1; \
    (Xvfb :8 -screen 0 640x480x24 >/tmp/xvfb8.log 2>&1 &); sleep 3; \
    export LIBGL_ALWAYS_SOFTWARE=1 BBGPU_NULL=1 HOME=/root; \
    V=red=1:green=1:blue=1:alpha=0:depth=1:stencil=0; \
    DISPLAY=:8 timeout 900 glmark2-es2 --visual-config $V -s 64x64 -b :duration=0.05 >/tmp/sc-es2.log 2>&1; \
    DISPLAY=:8 timeout 900 glmark2 --visual-config $V -s 64x64 -b :duration=0.05 >/tmp/sc-gl.log 2>&1; \
    grep -q "bbgpu: Bootbox GPU bridge" /tmp/sc-es2.log; grep -q "Score" /tmp/sc-es2.log; \
    pkill -f "Xvfb :8" || true; apk del xvfb 2>&1 | tail -1; \
    echo "SHADER-CACHE-OK $(du -sk /root/.cache/mesa_shader_cache | cut -f1)KB"
ENV WINEPREFIX=/root/.wine WINEARCH=win64
RUN set -eux; \
    timeout 900 wineboot --init 2>&1 | tail -4 || true; \
    (timeout 120 wineserver -w 2>/dev/null || true); \
    rm -f /root/.wine/drive_c/windows/core; \
    for d in system32 syswow64; do \
      for f in /root/.wine/drive_c/windows/$d/*.dll; do \
        [ -f "$f" ] || continue; b=$(basename "$f"); \
        for src in /usr/lib/wine/x86_64-windows /usr/lib/wine/i386-windows; do \
          if [ -f "$src/$b" ] && [ "$(du -k "$f" | cut -f1)" = "$(du -k "$src/$b" | cut -f1)" ]; then ln -sf "$src/$b" "$f"; break; fi; \
        done; \
      done; \
    done; \
    test -f /root/.wine/drive_c/windows/system32/kernel32.dll; \
    printf 'export WINEPREFIX=/root/.wine\nexport WINEARCH=win64\nexport WINEESYNC=1\nexport WINEDEBUG=-all\n' > /etc/profile.d/wine.sh; \
    printf '#!/bin/sh\nexport WINEESYNC="${WINEESYNC:-1}"\nexport WINEDEBUG="${WINEDEBUG:--all}"\nexec /usr/bin/wine "$@"\n' > /usr/local/bin/wine; \
    chmod +x /usr/local/bin/wine; \
    timeout 120 wine reg add "HKCU\\Control Panel\\Desktop" /v FontSmoothing /t REG_SZ /d 0 /f; \
    (timeout 60 wineserver -w || true); \
    echo "WINE-PREFIX-OK prefix=$(du -sh /root/.wine | cut -f1)"
RUN set -eux; \
    mkdir -p /opt/cpuz; cd /opt/cpuz; \
    for f in cpuz_x64.exe cpuz.ini; do \
      curl -fsSL --retry 3 -o "$f" "https://github.com/yu314-coder/Bootbox/releases/download/cpuz-v1/$f"; done; \
    ls -la /opt/cpuz; \
    rm -rf /usr/lib/sane /usr/lib/libsane* /etc/sane.d /usr/lib/libOpenCL* /etc/OpenCL; \
    rm -rf /usr/lib/wine/i386-windows /usr/lib/wine/i386-unix; \
    echo "CPUZ-OK (64-bit Wine only: the 32-bit side is 209 MB; full Wine stays in the Linux Terminal image; GStreamer stays: WebKit links it)"
COPY desktop/bench/cpuz-bench desktop/bench/gpu-bench desktop/bench/cpuz-gui desktop/bench/bench-all /usr/local/bin/
# Warm Wine's first-GUI-run and CPU-Z's first start (font caches, registry, DLL loads) at native
# speed; on the device the first CPU-Z start then skips minutes of one-time setup.
RUN set -eux; \
    chmod +x /usr/local/bin/cpuz-bench /usr/local/bin/gpu-bench /usr/local/bin/cpuz-gui; \
    apk add --no-cache xvfb 2>&1 | tail -1; \
    (Xvfb :9 -screen 0 800x600x16 >/tmp/xvfb.log 2>&1 &); sleep 3; \
    export DISPLAY=:9 WINEESYNC=1 WINEDEBUG=-all LIBGL_ALWAYS_SOFTWARE=1; \
    mkdir -p /root/cpuz; cp /opt/cpuz/* /root/cpuz/; \
    (cd /root/cpuz && timeout 240 wine cpuz_x64.exe -txt=warm >/dev/null 2>&1 || true); \
    LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe timeout 300 glmark2-es2 --visual-config red=1:green=1:blue=1:alpha=0:depth=1:stencil=0 \
      --size 160x120 -b clear:duration=2 2>&1 | grep -E "FPS|Error" ; \
    LIBGL_ALWAYS_SOFTWARE=1 timeout 300 glmark2-es2 --visual-config red=1:green=1:blue=1:alpha=0:depth=1:stencil=0 \
      --size 160x120 -b clear:duration=2 2>&1 | grep -q "FPS"; \
    ls /root/cpuz; \
    (timeout 60 wineserver -k || true); sleep 2; \
    (cpuz-gui >/tmp/cpuz-gui.log 2>&1 &); sleep 50; \
    xwininfo -root -tree | grep -E '"CPU-Z' | head -4; \
    ! xwininfo -root -tree | grep -q '"CPU-Z Error"'; xwininfo -root -tree | grep -qE '"CPU-Z ?"'; echo "CPUZ-GUI-DIALOG-ANSWERED"; \
    (timeout 60 wineserver -k || true); sleep 2; pkill Xvfb || true; \
    rm -f /root/.wine/drive_c/windows/core /root/cpuz/warm.txt; \
    apk del xvfb 2>&1 | tail -1; \
    echo "BENCH-WARM-OK"

# 3c) First-run warm-up (the wine lesson applied to the desktop): GTK's first start builds icon
#     and mime caches — minutes on the emulated CPU that make PCManFM look hung. Run both GUI
#     apps once against a throwaway X here at native speed; also refresh the shared caches
#     explicitly so the artifacts are deterministic.
RUN set -eux; \
    apk add --no-cache xvfb 2>&1 | tail -1; \
    gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true; \
    update-mime-database /usr/share/mime 2>/dev/null || true; \
    (Xvfb :9 -screen 0 640x480x16 >/tmp/xvfb.log 2>&1 &); sleep 3; \
    (DISPLAY=:9 timeout 60 pcmanfm >/tmp/warm-pc.log 2>&1 &); sleep 20; \
    (DISPLAY=:9 timeout 40 dillo about:blank >/tmp/warm-d.log 2>&1 &); sleep 12; \
    pkill pcmanfm 2>/dev/null || true; pkill dillo 2>/dev/null || true; \
    apk add --no-cache gstreamer-tools 2>&1 | tail -1; gst-inspect-1.0 >/dev/null 2>&1 || true; apk del gstreamer-tools 2>&1 | tail -1; \
    . /etc/profile.d/10desktop.sh; \
    (DISPLAY=:9 BBWEB_LOG=1 timeout 60 bbweb >/tmp/warm-w.log 2>&1 &); sleep 25; \
    test -S /tmp/.bbweb.sock; DISPLAY=:9 bbweb; DISPLAY=:9 bbweb https://example.org; sleep 8; \
    test "$(pgrep bbweb-engine | wc -l)" = 1; grep -q "title: Example Domain" /tmp/warm-w.log; echo "BBWEB-SINGLE-INSTANCE-OK"; \
    ps -o pid,ppid,args | grep -i "[w]ebkit\|[b]bweb"; grep -E "^phase|^title" /tmp/warm-w.log; \
    test "$(pgrep -f WebKitWebProcess | wc -l)" = 1; grep -q mimalloc /proc/$(pgrep -f WebKitWebProcess | head -1)/maps; \
    grep -q "blocker-on" /tmp/warm-w.log; test -n "$(ls -A /root/.cache/bbweb/filters)"; echo "BBWEB-ONE-PROCESS-MIMALLOC-BLOCKER-OK"; \
    DISPLAY=:9 bbweb bootbox://app/hub; DISPLAY=:9 bbweb 'bootbox://app/webbench?auto=1&budget=300'; sleep 20; \
    grep -q "title: Benchmarks" /tmp/warm-w.log; grep -q "title: Web benchmark" /tmp/warm-w.log; \
    grep -q '"id":"web"' /root/.bootbox/results.jsonl; grep -q "title: Benchmarks (1)" /tmp/warm-w.log; echo "BBWEB-HUB-WEBBENCH-SAVE-OK"; \
    pkill bbweb-engine 2>/dev/null || true; pkill -f WebKit 2>/dev/null || true; sleep 2; \
    (DISPLAY=:9 bootbox-conky >/tmp/conky.log 2>&1 &); sleep 10; pgrep -f "bin/conky " >/dev/null || { cat /tmp/conky.log; ps; exit 1; }; pkill -f "bin/conky "; echo "CONKY-OK"; \
    sysbench-bench | tail -4; 7z-bench 2>/dev/null | tail -5; \
    grep -q '"id":"sysbench","label":"sysbench CPU (primes)","cores":[0-9]*,"single":[0-9.]*,"multi":[0-9.]*' /root/.bootbox/results.jsonl; \
    grep -q '"id":"7zip".*"single":[0-9]*,"multi":[0-9]*' /root/.bootbox/results.jsonl; echo "BENCH-RESULTS-OK"; \
    rm -rf /root/.bootbox; \
    (DISPLAY=:9 BBWEB_LOG=1 timeout 45 /usr/libexec/bbweb-engine https://example.com >/tmp/warm-w2.log 2>&1 &); sleep 30; \
    pkill bbweb-engine 2>/dev/null || true; pkill -f WebKit 2>/dev/null || true; sleep 2; pkill Xvfb || true; \
    rm -f /tmp/.bbweb.sock /tmp/.bbweb.lock; \
    cat /tmp/warm-w.log /tmp/warm-w2.log | grep -v "^$" | tail -12; \
    grep -q "title: Start$" /tmp/warm-w.log; \
    (grep -q "title: Example Domain" /tmp/warm-w2.log && echo "BBWEB-HTTPS-OK") || echo "BBWEB-HTTPS-NOT-VERIFIED (build network?)"; \
    find /root/.cache/bbweb -mindepth 1 -maxdepth 1 ! -name filters -exec rm -rf {} +; \
    rm -rf /root/.local/share/bbweb /root/.local/share/webkitgtk; \
    apk del xvfb 2>&1 | tail -1; \
    echo "DESKTOP-WARM-OK"

# 4) Slim (docs/man/locale/extra fonts) — keeps the download small.
RUN set -eux; \
    rm -rf /usr/share/man /usr/share/doc /usr/share/gtk-doc /usr/share/locale /usr/share/i18n /usr/share/info /var/cache/apk/*; \
    (cd /usr/share/fonts/dejavu 2>/dev/null && ls | grep -vE '^(DejaVuSans\.ttf|DejaVuSans-Bold\.ttf|DejaVuSansMono\.ttf|DejaVuSansMono-Bold\.ttf|fonts\.)' | xargs rm -f) || true; \
    # v17: font caches that stay VALID in the guest. The image conversion keeps whole-second mtimes but
    # drops the nanoseconds, and fontconfig 2.15 compares both, so the caches built here were stale on
    # every boot and each GUI program rebuilt them while the desktop started (openbox ~19.5 s of emulated
    # CPU instead of ~4.5 s, the panel too). Zero the font folders' nanoseconds, then build the caches;
    # a second `fc-cache` must find every one of them still valid.
    find /usr/share/fonts /usr/local/share/fonts -type d 2>/dev/null | while read -r d; do touch -d "@$(stat -c %Y "$d")" "$d"; done; \
    ! find /usr/share/fonts -type d -exec stat -c '%y %n' {} + | grep -v '\.000000000 '; \
    fc-cache -f 2>/dev/null || true; \
    fc-cache -v > /tmp/fcv.log 2>&1 || true; grep -c 'existing cache is valid' /tmp/fcv.log; \
    ! grep -E 'caching, (new|updated)' /tmp/fcv.log; rm -f /tmp/fcv.log; echo "FONT-CACHE-NS-OK"; \
    # v18: the editor's syntax languages - keep the common ones (see the header)
    L=/usr/share/gtksourceview-3.0/language-specs; mkdir -p /tmp/lang; mv $L/* /tmp/lang/; \
    for k in def sh python c cpp chdr cpp-header javascript json html css xml markdown yaml ini makefile diff \
             java go rust sql dockerfile cmake perl ruby php desktop; do \
      [ -f /tmp/lang/$k.lang ] && mv /tmp/lang/$k.lang $L/; done; \
    mv /tmp/lang/*.rng $L/ 2>/dev/null || true; rm -rf /tmp/lang; \
    n=$(ls $L/*.lang | wc -l); [ "$n" -ge 20 ] && [ -f $L/def.lang ] && [ -f $L/python.lang ] && echo "EDITOR-LANGS-OK $n"; \
    echo "SLIM usr=$(du -sm /usr | cut -f1)MB total=$(du -sm / 2>/dev/null | cut -f1)MB"

# v21 direct display: Xorg (modesetting on the virtio GPU, evdev for the virtio tablet + keyboard), started
# by bb-xorg from xstart; Xvnc stays as the fallback. Late layer (keeps the cache above); the Bootbox
# GPU-bridge Mesa driver installed earlier must survive it unchanged.
RUN set -eux; \
    g=/usr/lib/xorg/modules/dri/libgallium_dri.so; before=$(md5sum $g | cut -d' ' -f1); \
    apk add --no-cache xorg-server xf86-input-evdev 2>&1 | tail -1; \
    test "$(md5sum $g | cut -d' ' -f1)" = "$before"; \
    test -f /usr/lib/xorg/modules/drivers/modesetting_drv.so; test -f /usr/lib/xorg/modules/input/evdev_drv.so; \
    Xorg -version 2>&1 | head -2; chmod +x /usr/local/bin/bb-xorg; \
    echo "XORG-DIRECT-OK"

# Boots straight into the full desktop (launcher menu + browser + file manager).
COPY xstart-desktop.sh /usr/local/bin/xstart
# Start the desktop's X server with xstart's EXACT command line and require its socket: an option this
# Xvnc doesn't know (v9's -DeferUpdate) makes it exit at once and the desktop never appears.
RUN set -eux; chmod +x /usr/local/bin/xstart; \
    cmd=$(sed -e ':a' -e '/\\$/{N;s/\\\n//;ba' -e '}' /usr/local/bin/xstart | grep -o 'Xvnc :0[^>]*' | tr -s ' '); echo "$cmd"; \
    (eval "timeout 20 $cmd" >/tmp/xvnc-test.log 2>&1 &); \
    for i in $(seq 1 30); do [ -e /tmp/.X11-unix/X0 ] && break; sleep 0.5; done; \
    test -e /tmp/.X11-unix/X0 || { cat /tmp/xvnc-test.log; exit 1; }; \
    pkill Xvnc || true; rm -rf /tmp/.X11-unix /tmp/.X0-lock /tmp/xvnc-test.log; echo "XVNC-ARGS-OK"
CMD ["/usr/local/bin/xstart"]
